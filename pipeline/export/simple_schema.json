{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Khet Sathi farmer cards",
 "description": "site/data/simple/<field>.json (owner, 2026-11-14 evening; rules.yaml simple_cards): what the three farmer cards say, per answer to the two questions. Built from the field's Replay and Field Pulse files only.",
 "type": "object",
 "additionalProperties": false,
 "required": ["field", "placeholder", "made_by", "window", "start", "winters", "answers", "replay_card", "trial_card", "plan_lines", "pulse_card", "label", "sources",
              "labels_used", "today", "guess", "plan_words", "actions", "animation", "weather_lines"],
 "$defs": {
  "three": {"type": "object", "additionalProperties": false, "required": ["better", "same", "worse"],
            "properties": {"better": {"type": "integer", "minimum": 0}, "same": {"type": "integer", "minimum": 0}, "worse": {"type": "integer", "minimum": 0}}},
  "card": {"type": "object", "additionalProperties": false, "required": ["plan", "crop", "counts", "per_ten", "verdict"],
           "properties": {"plan": {"enum": ["cover_gap", "safest"]}, "crop": {"type": "string", "minLength": 1},
                          "counts": {"$ref": "#/$defs/three"}, "per_ten": {"$ref": "#/$defs/three"},
                          "verdict": {"enum": ["better", "same", "worse", "mixed"]}}}
 },
 "properties": {
  "field": {"type": "string", "minLength": 1},
  "placeholder": {"type": "boolean"},
  "made_by": {"type": "string"},
  "window": {"enum": ["m3", "m6"]},
  "start": {"enum": ["dry", "medium", "wet"]},
  "winters": {"type": "integer", "minimum": 1},
  "answers": {"type": "object", "additionalProperties": false, "required": ["winter", "default_winter"],
              "properties": {"winter": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "default_winter": {"type": "string"}}},
  "replay_card": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["water_no", "water_yes"],
                   "properties": {"water_no": {"$ref": "#/$defs/card"}, "water_yes": {"$ref": "#/$defs/card"}}}},
  "trial_card": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["plan", "crop"],
                  "properties": {"plan": {"enum": ["cover_gap", "safest"]}, "crop": {"type": "string"}}}},
  "plan_lines": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
                  "required": ["crop", "counts", "per_ten"], "properties": {"crop": {"type": "string"}, "counts": {"$ref": "#/$defs/three"}, "per_ten": {"$ref": "#/$defs/three"}}}}},
  "pulse_card": {"type": "object", "additionalProperties": false, "required": ["growing", "source"],
                 "properties": {"growing": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["crop", "from", "to"],
                                 "properties": {"crop": {"type": "string"}, "from": {"type": "string", "pattern": "^[01][0-9]-[0-3][0-9]$"},
                                                "to": {"type": "string", "pattern": "^[01][0-9]-[0-3][0-9]$"}}}},
                                "source": {"type": "string"}}},
  "label": {"type": "object"},
  "sources": {"type": "array"},
  "labels_used": {"type": "object", "description": "The labels the farmer wording was chosen from (rules.yaml farmer_answers.wording).", "additionalProperties": {"enum": ["VERIFIED", "ESTIMATE", "NOT YET VERIFIABLE"]}},
  "today": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["compare", "band"]}}},
  "guess": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}, "fill": {"type": "object"}}},
  "plan_words": {"type": "object", "description": "[winter answer][window][start][plan id]: {now: true} for the farmer's own plan, else {counts, verdict, text}", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "properties": {"now": {"const": true}, "counts": {"type": "object"}, "verdict": {"enum": ["better", "same", "worse", "mixed"]}, "text": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}}}}}}},
  "actions": {"type": "object", "description": "[plan or option id][window]: lines", "additionalProperties": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}, "fill": {"type": "object"}}}}}},
  "animation": {"type": "object", "additionalProperties": false, "required": ["plans", "winner", "window", "start", "seasons", "failed_below"], "properties": {"plans": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "green", "green_count", "median"], "properties": {"id": {"type": "string"}, "green": {"type": "array", "items": {"type": ["boolean", "null"]}}, "green_count": {"type": "integer", "minimum": 0}, "median": {"type": ["number", "null"]}}}}, "winner": {"type": "string"}, "window": {"type": "string"}, "start": {"type": "string"}, "seasons": {"type": "array", "items": {"type": "string"}}, "failed_below": {"type": "number"}}},
  "weather_lines": {"type": "object", "description": "[winter answer][can water: no|yes][block key]: {usual, danger, tip}", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["usual", "danger", "tip"], "properties": {"usual": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}, "fill": {"type": "object"}}}, "danger": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}, "fill": {"type": "object"}}}, "tip": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}, "fill": {"type": "object"}}}, {"type": "null"}]}}}}}}
 }
}
