{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Khet Sathi Data Check-up",
 "description": "site/data/checkup/<field>.json (2026-11-14, rules.yaml checkup): how this field's rain record was checked.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "field",
  "placeholder",
  "made_by",
  "sources",
  "evidence_level",
  "break_test",
  "evidence",
  "correction",
  "versions",
  "yearly",
  "depends_on_corrected_rain",
  "label"
 ],
 "properties": {
  "field": {
   "type": "string",
   "minLength": 1
  },
  "placeholder": {
   "type": "boolean"
  },
  "made_by": {
   "type": "string"
  },
  "sources": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/source"
   }
  },
  "evidence_level": {
   "enum": [
    "full",
    "own_break_test"
   ]
  },
  "break_test": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "found",
    "year",
    "checks",
    "rule",
    "own_run"
   ],
   "properties": {
    "found": {
     "type": "boolean"
    },
    "year": {
     "type": [
      "integer",
      "null"
     ]
    },
    "checks": {
     "type": "object",
     "additionalProperties": {
      "type": "boolean"
     }
    },
    "rule": {
     "type": "string"
    },
    "own_run": {
     "type": "string"
    }
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "source"
    ],
    "properties": {
     "id": {
      "enum": [
       "gauge_weight",
       "gpcc_stations",
       "chirps_steady",
       "gpm_vs_chirps",
       "imerg_late",
       "pettitt_gpm",
       "dhm_normals"
      ]
     },
     "source": {
      "type": "string"
     }
    }
   }
  },
  "correction": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "break",
    "gauge_factors",
    "rule"
   ],
   "properties": {
    "break": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "from",
        "reference_years",
        "factors_by_month"
       ],
       "properties": {
        "from": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reference_years": {
         "type": "array",
         "items": {
          "type": "integer"
         }
        },
        "factors_by_month": {
         "type": "object",
         "additionalProperties": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       }
      }
     ]
    },
    "gauge_factors": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "jjas",
        "other",
        "applied"
       ],
       "properties": {
        "jjas": {
         "type": "number"
        },
        "other": {
         "type": "number"
        },
        "applied": {
         "type": "boolean"
        }
       }
      }
     ]
    },
    "rule": {
     "type": "string"
    }
   }
  },
  "versions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "central",
     "mean_mm_per_year"
    ],
    "properties": {
     "id": {
      "enum": [
       "tuned",
       "untuned",
       "dhm",
       "uncorrected"
      ]
     },
     "central": {
      "type": "boolean"
     },
     "mean_mm_per_year": {
      "type": "number",
      "minimum": 0
     }
    }
   }
  },
  "yearly": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "years",
    "gpm",
    "twin",
    "chirps"
   ],
   "properties": {
    "years": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "gpm": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0
     }
    },
    "twin": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0
     }
    },
    "chirps": {
     "type": "array",
     "items": {
      "type": [
       "number",
       "null"
      ]
     }
    }
   }
  },
  "depends_on_corrected_rain": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "label": {
   "$ref": "#/$defs/label"
  }
 },
 "$defs": {
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "product",
    "resolution",
    "years",
    "type"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "product": {
     "type": "string",
     "minLength": 1
    },
    "resolution": {
     "type": "string",
     "minLength": 1
    },
    "years": {
     "type": "string",
     "minLength": 1
    },
    "type": {
     "enum": [
      "satellite",
      "model",
      "station",
      "probe"
     ],
     "description": "Golden rule 8: model-based data must be labelled model."
    }
   }
  },
  "label": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sure",
    "status",
    "k",
    "n",
    "scale",
    "rain_corrected",
    "sources",
    "scorecard"
   ],
   "properties": {
    "sure": {
     "enum": [
      "verified",
      "estimate"
     ],
     "description": "verified only when status is VERIFIED"
    },
    "status": {
     "enum": [
      "VERIFIED",
      "ESTIMATE",
      "NOT YET VERIFIABLE"
     ]
    },
    "k": {
     "type": "integer",
     "minimum": 0
    },
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "scale": {
     "enum": [
      "field",
      "neighbourhood",
      "valley",
      "region"
     ]
    },
    "rain_corrected": {
     "type": "boolean"
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scorecard": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  }
 }
}
