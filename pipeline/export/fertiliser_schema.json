{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Khet Sathi fertiliser saver",
 "description": "site/data/fertiliser/<field>.json (2026-11-14, rules.yaml fertiliser_saver): the urea the crop after the legume of the 'Feed your soil' plan (id safest) may not need, per hectare, from a published carry-over range.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "field",
  "placeholder",
  "made_by",
  "labels",
  "why",
  "sources",
  "applies",
  "plan"
 ],
 "properties": {
  "field": {
   "type": "string",
   "minLength": 1
  },
  "placeholder": {
   "type": "boolean"
  },
  "made_by": {
   "type": "string"
  },
  "labels": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/label"
   }
  },
  "why": {
   "$ref": "#/$defs/why"
  },
  "sources": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/source"
   }
  },
  "applies": {
   "type": "boolean"
  },
  "plan": {
   "const": "safest"
  },
  "legume": {
   "type": "string"
  },
  "next_crop": {
   "type": "string"
  },
  "area": {
   "const": "hectare"
  },
  "n_kg_ha": {
   "type": "array",
   "items": {
    "type": "number",
    "minimum": 0
   },
   "minItems": 2,
   "maxItems": 2
  },
  "urea_n_share": {
   "type": "number",
   "exclusiveMinimum": 0,
   "maximum": 1
  },
  "bag_kg": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "urea_kg_ha": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0
   },
   "minItems": 2,
   "maxItems": 2
  },
  "bags_ha": {
   "type": "array",
   "items": {
    "type": "number",
    "minimum": 0
   },
   "minItems": 2,
   "maxItems": 2
  },
  "bags_ha_whole": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0
   },
   "minItems": 2,
   "maxItems": 2
  },
  "measured_uptake_kg_n_ha": {
   "type": "number",
   "minimum": 0
  }
 },
 "$defs": {
  "label": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sure",
    "status",
    "k",
    "n",
    "scale",
    "rain_corrected",
    "sources",
    "scorecard"
   ],
   "properties": {
    "sure": {
     "enum": [
      "verified",
      "estimate"
     ],
     "description": "verified only when status is VERIFIED"
    },
    "status": {
     "enum": [
      "VERIFIED",
      "ESTIMATE",
      "NOT YET VERIFIABLE"
     ]
    },
    "k": {
     "type": "integer",
     "minimum": 0
    },
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "scale": {
     "enum": [
      "field",
      "neighbourhood",
      "valley",
      "region"
     ]
    },
    "rain_corrected": {
     "type": "boolean"
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scorecard": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "product",
    "resolution",
    "years",
    "type"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "product": {
     "type": "string",
     "minLength": 1
    },
    "resolution": {
     "type": "string",
     "minLength": 1
    },
    "years": {
     "type": "string",
     "minLength": 1
    },
    "type": {
     "enum": [
      "satellite",
      "model",
      "station",
      "probe",
      "document"
     ],
     "description": "Golden rule 8: model-based data is labelled model; 'document' is a published text a rule comes from (a definition, a range, a constant)."
    }
   }
  },
  "why": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "en",
    "ne",
    "ne_review",
    "drafted_by"
   ],
   "properties": {
    "en": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "ne": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "ne_review": {
     "type": "string"
    },
    "drafted_by": {
     "type": "string"
    }
   }
  },
  "mmdd": {
   "type": "string",
   "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
  },
  "window": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "from",
    "to",
    "days"
   ],
   "properties": {
    "from": {
     "$ref": "#/$defs/mmdd"
    },
    "to": {
     "$ref": "#/$defs/mmdd"
    },
    "days": {
     "type": "integer",
     "minimum": 1
    },
    "stage": {
     "enum": [
      "late"
     ]
    }
   }
  }
 },
 "if": {
  "properties": {
   "applies": {
    "const": true
   }
  }
 },
 "then": {
  "required": [
   "legume",
   "next_crop",
   "area",
   "n_kg_ha",
   "urea_n_share",
   "bag_kg",
   "urea_kg_ha",
   "bags_ha",
   "bags_ha_whole",
   "measured_uptake_kg_n_ha"
  ]
 }
}
