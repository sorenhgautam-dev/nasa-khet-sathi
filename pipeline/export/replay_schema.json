{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Khet Sathi 25-Year Replay",
 "description": "site/data/replay/<field>.json (2026-11-14, rules.yaml window_replay): each plan's coming season through every past season, rain-fed.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "field",
  "placeholder",
  "made_by",
  "sources",
  "start",
  "start_rule",
  "windows",
  "year_count",
  "seasons",
  "water_case",
  "watering",
  "starts",
  "start_band_crop",
  "start_default",
  "twin_today",
  "enso",
  "thresholds",
  "plans",
  "label"
 ],
 "properties": {
  "field": {
   "type": "string",
   "minLength": 1
  },
  "placeholder": {
   "type": "boolean"
  },
  "made_by": {
   "type": "string"
  },
  "sources": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/source"
   }
  },
  "start": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "start_rule": {
   "type": "string"
  },
  "windows": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "months",
     "from",
     "to"
    ],
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "m3",
       "m6"
      ]
     },
     "months": {
      "type": "integer",
      "minimum": 1
     },
     "from": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}$"
     },
     "to": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}$"
     }
    }
   }
  },
  "year_count": {
   "type": "integer",
   "minimum": 1
  },
  "seasons": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}$"
   }
  },
  "water_case": {
   "const": "rain-fed"
  },
  "watering": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "removes_dry_stress",
    "en"
   ],
   "properties": {
    "removes_dry_stress": {
     "const": true
    },
    "en": {
     "type": "string"
    }
   }
  },
  "starts": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "probe_band",
     "depletion_fraction",
     "wetness_pct"
    ],
    "properties": {
     "id": {
      "enum": [
       "dry",
       "medium",
       "wet"
      ]
     },
     "probe_band": {
      "enum": [
       "needs water",
       "good",
       "too wet"
      ]
     },
     "depletion_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "wetness_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
     }
    }
   }
  },
  "start_band_crop": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "crop",
    "p"
   ],
   "properties": {
    "crop": {
     "type": "string"
    },
    "p": {
     "type": "number"
    }
   }
  },
  "start_default": {
   "enum": [
    "dry",
    "medium",
    "wet"
   ]
  },
  "twin_today": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "date",
      "wetness_pct",
      "band",
      "crop"
     ],
     "properties": {
      "date": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "wetness_pct": {
       "type": "number"
      },
      "band": {
       "enum": [
        "needs water",
        "good"
       ]
      },
      "crop": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    }
   ]
  },
  "enso": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now",
    "by_season",
    "same_as_now",
    "rule",
    "source"
   ],
   "properties": {
    "now": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "season",
      "year",
      "oni",
      "state"
     ],
     "properties": {
      "season": {
       "enum": [
        "DJF",
        "JFM",
        "FMA",
        "MAM",
        "AMJ",
        "MJJ",
        "JJA",
        "JAS",
        "ASO",
        "SON",
        "OND",
        "NDJ"
       ]
      },
      "year": {
       "type": "integer"
      },
      "oni": {
       "type": "number"
      },
      "state": {
       "enum": [
        "el_nino",
        "la_nina",
        "neutral"
       ]
      }
     }
    },
    "by_season": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "season",
       "year",
       "oni",
       "state"
      ],
      "properties": {
       "season": {
        "enum": [
         "DJF",
         "JFM",
         "FMA",
         "MAM",
         "AMJ",
         "MJJ",
         "JJA",
         "JAS",
         "ASO",
         "SON",
         "OND",
         "NDJ"
        ]
       },
       "year": {
        "type": "integer"
       },
       "oni": {
        "type": [
         "number",
         "null"
        ]
       },
       "state": {
        "enum": [
         "el_nino",
         "la_nina",
         "neutral",
         null
        ]
       }
      }
     }
    },
    "same_as_now": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "rule": {
     "type": "string"
    },
    "source": {
     "$ref": "#/$defs/source"
    }
   }
  },
  "thresholds": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "score",
    "worked_min",
    "failed_below",
    "sensitive",
    "source"
   ],
   "properties": {
    "score": {
     "type": "string"
    },
    "worked_min": {
     "type": "number"
    },
    "failed_below": {
     "type": "number"
    },
    "sensitive": {
     "type": "string"
    },
    "source": {
     "type": "string"
    }
   }
  },
  "plans": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "role",
     "crops_in_window",
     "results",
     "summary"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "role": {
      "enum": [
       "current",
       "suggested",
       "current_option"
      ]
     },
     "crops_in_window": {
      "type": "object",
      "propertyNames": {
       "type": "string",
       "enum": [
        "m3",
        "m6"
       ]
      },
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "crop",
         "start",
         "end",
         "in_ground_at_start"
        ],
        "properties": {
         "crop": {
          "type": "string"
         },
         "start": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}$"
         },
         "end": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}$"
         },
         "in_ground_at_start": {
          "type": "boolean"
         }
        }
       }
      }
     },
     "results": {
      "type": "object",
      "propertyNames": {
       "type": "string",
       "enum": [
        "m3",
        "m6"
       ]
      },
      "additionalProperties": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "dry",
        "medium",
        "wet"
       ],
       "properties": {
        "dry": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/result"
         }
        },
        "medium": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/result"
         }
        },
        "wet": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/result"
         }
        }
       }
      }
     },
     "summary": {
      "type": "object",
      "propertyNames": {
       "type": "string",
       "enum": [
        "m3",
        "m6"
       ]
      },
      "additionalProperties": {
       "type": "object",
       "required": [
        "dry",
        "medium",
        "wet"
       ],
       "additionalProperties": false,
       "properties": {
        "dry": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "worked",
          "struggled",
          "failed",
          "no_crop",
          "sensitive"
         ],
         "properties": {
          "worked": {
           "type": "integer",
           "minimum": 0
          },
          "struggled": {
           "type": "integer",
           "minimum": 0
          },
          "failed": {
           "type": "integer",
           "minimum": 0
          },
          "no_crop": {
           "type": "integer",
           "minimum": 0
          },
          "sensitive": {
           "type": "integer",
           "minimum": 0
          }
         }
        },
        "medium": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "worked",
          "struggled",
          "failed",
          "no_crop",
          "sensitive"
         ],
         "properties": {
          "worked": {
           "type": "integer",
           "minimum": 0
          },
          "struggled": {
           "type": "integer",
           "minimum": 0
          },
          "failed": {
           "type": "integer",
           "minimum": 0
          },
          "no_crop": {
           "type": "integer",
           "minimum": 0
          },
          "sensitive": {
           "type": "integer",
           "minimum": 0
          }
         }
        },
        "wet": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "worked",
          "struggled",
          "failed",
          "no_crop",
          "sensitive"
         ],
         "properties": {
          "worked": {
           "type": "integer",
           "minimum": 0
          },
          "struggled": {
           "type": "integer",
           "minimum": 0
          },
          "failed": {
           "type": "integer",
           "minimum": 0
          },
          "no_crop": {
           "type": "integer",
           "minimum": 0
          },
          "sensitive": {
           "type": "integer",
           "minimum": 0
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "label": {
   "$ref": "#/$defs/label"
  }
 },
 "$defs": {
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "product",
    "resolution",
    "years",
    "type"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "product": {
     "type": "string",
     "minLength": 1
    },
    "resolution": {
     "type": "string",
     "minLength": 1
    },
    "years": {
     "type": "string",
     "minLength": 1
    },
    "type": {
     "enum": [
      "satellite",
      "model",
      "station",
      "probe"
     ],
     "description": "Golden rule 8: model-based data must be labelled model."
    }
   }
  },
  "label": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sure",
    "status",
    "k",
    "n",
    "scale",
    "rain_corrected",
    "sources",
    "scorecard"
   ],
   "properties": {
    "sure": {
     "enum": [
      "verified",
      "estimate"
     ],
     "description": "verified only when status is VERIFIED"
    },
    "status": {
     "enum": [
      "VERIFIED",
      "ESTIMATE",
      "NOT YET VERIFIABLE"
     ]
    },
    "k": {
     "type": "integer",
     "minimum": 0
    },
    "n": {
     "type": "integer",
     "minimum": 0
    },
    "scale": {
     "enum": [
      "field",
      "neighbourhood",
      "valley",
      "region"
     ]
    },
    "rain_corrected": {
     "type": "boolean"
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scorecard": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "result": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "season",
    "year",
    "result",
    "score",
    "dry_days",
    "rain_mm",
    "reason",
    "enso",
    "sensitive",
    "other_versions"
   ],
   "properties": {
    "season": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}$"
    },
    "year": {
     "type": "integer"
    },
    "result": {
     "enum": [
      "worked",
      "struggled",
      "failed",
      null
     ]
    },
    "score": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "dry_days": {
     "type": "integer",
     "minimum": 0
    },
    "rain_mm": {
     "type": "number",
     "minimum": 0
    },
    "reason": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "code",
        "month",
        "days"
       ],
       "properties": {
        "code": {
         "const": "dry_spell"
        },
        "month": {
         "type": "string",
         "pattern": "^(0[1-9]|1[0-2])$"
        },
        "days": {
         "type": "integer",
         "minimum": 1
        }
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "code"
       ],
       "properties": {
        "code": {
         "enum": [
          "no_dry_days",
          "no_crop_in_window"
         ]
        }
       }
      }
     ]
    },
    "enso": {
     "enum": [
      "el_nino",
      "la_nina",
      "neutral",
      null
     ]
    },
    "sensitive": {
     "type": "boolean"
    },
    "other_versions": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "untuned",
      "dhm",
      "uncorrected"
     ],
     "properties": {
      "untuned": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "result",
        "score"
       ],
       "properties": {
        "result": {
         "enum": [
          "worked",
          "struggled",
          "failed",
          null
         ]
        },
        "score": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0,
         "maximum": 100
        }
       }
      },
      "dhm": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "result",
        "score"
       ],
       "properties": {
        "result": {
         "enum": [
          "worked",
          "struggled",
          "failed",
          null
         ]
        },
        "score": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0,
         "maximum": 100
        }
       }
      },
      "uncorrected": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "result",
        "score"
       ],
       "properties": {
        "result": {
         "enum": [
          "worked",
          "struggled",
          "failed",
          null
         ]
        },
        "score": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0,
         "maximum": 100
        }
       }
      }
     }
    }
   }
  }
 }
}
