{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khet-sathi/schema/index.json",
  "title": "Khet Sathi prepared-field index: site/data/index.json",
  "description": "From CLAUDE.md 'The output contract'. Powers 'Try our demo field' and the 'outside every prepared area' message. bbox is [min_lon, min_lat, max_lon, max_lat]. REVIEW_2 H6 (2026-11-14): written by pipeline/export/build_index.py from every config/fields/<id>.yaml whose site/data/fields/<id>.json exists; `sample` marks a sample field, `area` the area map it belongs to (null: none).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fields"
  ],
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "country",
          "lat",
          "lon",
          "bbox",
          "sample",
          "area"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "File name: site/data/fields/<id>.json"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "sample": {
            "type": "boolean",
            "description": "a sample field near a demo field (labelled PLACEHOLDER), not a farmer's"
          },
          "area": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9-]+$",
            "description": "id of the area in `areas` holding this field"
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "description": "prepared areas with a map of their farmland (site/data/area/<id>.json)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "bbox",
          "map",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "map": {
            "type": "string",
            "pattern": "^data/area/[a-z0-9-]+\\.json$",
            "description": "relative path (the site has no absolute paths)"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
