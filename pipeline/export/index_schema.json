{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khet-sathi/schema/index.json",
  "title": "Khet Sathi prepared-field index: site/data/index.json",
  "description": "From CLAUDE.md 'The output contract'. Powers 'Try our demo field' and the 'outside every prepared area' message. bbox is [min_lon, min_lat, max_lon, max_lat].",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields"],
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "country", "lat", "lon", "bbox"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "File name: site/data/fields/<id>.json"},
          "name": {"type": "string", "minLength": 1},
          "country": {"type": "string", "minLength": 1},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "bbox": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": -180, "maximum": 180},
              {"type": "number", "minimum": -90, "maximum": 90},
              {"type": "number", "minimum": -180, "maximum": 180},
              {"type": "number", "minimum": -90, "maximum": 90}
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
