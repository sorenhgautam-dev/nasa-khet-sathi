# Raw and cleaned downloads, data cards, audit plots: large or rebuildable (CLAUDE.md rule 4)
# Leading slash matters: plain "data/" would also hide site/data/, the exports the live site needs.
/data/

# Secrets: Earthdata login lives in ~/.netrc, keys live in .env (CLAUDE.md rule 2)
.env
.env.*
.netrc
*.pem
*.key
credentials*.json

# Firmware and Firebase secrets (REVIEW_2 H7; owner's answer 14, 2026-11-13): the probe's key, Wi-Fi
# passwords and any service-account file stay out of the public repository
secrets.h
google-services.json
GoogleService-Info.plist
serviceAccount*.json
firebase-adminsdk*.json

# The live probe reading is written during the in-person demo only (owner's answer 19, 2026-11-13);
# the recorded site/data/probe_log.json IS committed
/site/data/live.json
/site/data/.live.json.tmp

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated review material (rebuild any time with scripts/make_review_pack.py)
/review_pack/
/review_pack.zip

# Team notes about project selection (a different project); kept off GitHub by the owner's choice
/Space Apps 2026 Jury-Grade Project Selection.docx

# OS
.DS_Store

# editor settings (personal; VS Code created this when .env appeared, 2026-11-12)
.vscode/
.gstack/
